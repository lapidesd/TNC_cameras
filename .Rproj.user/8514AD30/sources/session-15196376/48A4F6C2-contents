library(changepoint)
library(ggplot2)

flow <- read.csv("USPPFlowMonitoring2006_2025.csv")
flow <- flow[!is.na(flow$Flow.Code), ]
flow$Flow.Code <- as.numeric(flow$Flow.Code)

flow <- flow[flow$Flow.Code %in% c(0, 1), ]
flow$Flow.Code[flow["Flow.Code"] == 2] <- 1
flow$Year <- as.numeric(format(as.Date(flow$Date), "%Y"))

flow <- flow[!(flow$Site %in% c("Cottonwood", "Escalante", "FairbankNorth", "LewisSprings", "Hereford", "Boquillas")),]
sites <- data.frame(Name = unique(flow$Site), Camera = c(6, 7, 1, 4, 2))
flow <- merge(flow, sites, by.x = "Site", by.y = "Name", all.x = TRUE)

par(mfrow = c(2, 3))

for (cam in sort(sites$Camera)) {
  camera_data <- flow[flow$Camera == cam,]
  camera_data <- aggregate(Flow.Code ~ Year, data = camera_data, FUN = mean)
  matrix <- cbind(as.numeric(camera_data$Flow.Code), 1, as.numeric(camera_data$Year))
  
  cp_reg <- cpt.reg(matrix, method = "PELT")
  cpts <- cpts(cp_reg)
  segments <- c(0, cpts, nrow(camera_data))
  params <- param.est(cp_reg)
  
  plot(camera_data$Year, camera_data$Flow.Code,
       pch = 19, col = "black",
       xlab = "", ylab = "Flow Code", main = paste("C", cam, sep = ""))
  colors <- rainbow(length(segments) - 1)
  for (i in 1:length(colors)) {
    idx <- (segments[i] + 1):segments[i + 1]
    intercept <- params$beta[i, 1]
    slope <- params$beta[i, 2]
    fitted <- intercept + slope * camera_data$Year[idx]
    lines(camera_data$Year[idx], fitted, col = colors[i], lwd = 2)
  }
}
