library(dplyr)
library(changepoint)
library(ggplot2)

flow <- read.csv("USPPFlowMonitoring2006_2025.csv")

flow <- flow[!is.na(flow$Flow.Code),]
flow$Flow.Code[flow["Flow.Code"] == 2] <- 1
flow <- flow[flow$Flow.Code %in% c(0, 1),]
flow$Date <- as.Date(flow$Date)

names <- data.frame(Site = c("Boquillas", "CharlestonMesquite", "Contention", "Fairbank", "Hereford", "Hunter", "Moson", "St.David"),
                    Camera = c(8, 2, 6, 1, 5, 4, 3, 7))
flow <- left_join(flow, names, by = "Site")

water_year <- function(date) {
  y <- as.numeric(format(date, "%Y"))
  m <- as.numeric(format(date, "%m"))
  ifelse(m >= 10, y + 1, y)
}
flow$WY <- water_year(flow$Date)

cor <- flow[flow$Camera %in% c(1, 2, 6, 7),]
cor <- aggregate(Flow.Code ~ WY, data = cor, FUN = mean)

matrix <- cbind(cor$Flow.Code, 1, cor$WY)
cp_reg <- cpt.reg(matrix, method = "PELT")
segments <- c(0, cpts(cp_reg), nrow(cor))
params <- param.est(cp_reg)

plot(cor$WY, cor$Flow.Code,
     pch = 19, col = "black",
     xlab = "", ylab = "Mean FP", main = "Mean FP Regression Change Points")
colors <- rainbow(length(segments) - 1)
for (i in 1:length(colors)) {
  idx <- (segments[i] + 1):segments[i + 1]
  intercept <- params$beta[i, 1]
  slope <- params$beta[i, 2]
  fitted <- intercept + slope * cor$WY[idx]
  lines(cor$WY[idx], fitted, col = colors[i], lwd = 2)
}

poly <- data.frame(WY = seq(min(cor$WY), max(cor$WY), length.out = 200))
poly$Fit <- predict(lm(Flow.Code ~ poly(WY, 2), data = cor), newdata = poly)

plot(cor$WY, cor$Flow.Code,
     pch = 19, col = "black",
     xlab = "", ylab = "Mean FP", main = "Yearly Mean FP")
lines(poly$WY, poly$Fit,
      col = "red", lwd = 3)

lag <- flow[flow$Camera %in% c(1, 2, 6, 7),]
lag <- aggregate(Flow.Code ~ Date, data = flow, FUN = mean)
lag$Sixty <- lag(lag$Flow.Code, 60)
lag <- lag[!is.na(lag$Sixty),]

plot(lag$Sixty, lag$Flow.Code, pch = 19, col = "black", xlab = "FP (60-day lag)", ylab = "FP",
     main = "Daily Mean FP vs. 60-Day Lag")

cor(lag$Sixty, lag$Flow.Code)

cor_norm <- cor
cor_norm$Flow.Code <- cor_norm$Flow.Code / median(cor_norm$Flow.Code, na.rm = TRUE)

matrix <- cbind(cor_norm$Flow.Code, 1, cor_norm$WY)
cp_reg <- cpt.reg(matrix, method = "PELT")
segments <- c(0, cpts(cp_reg), nrow(cor_norm))
params <- param.est(cp_reg)

plot(cor_norm$WY, cor_norm$Flow.Code,
     pch = 19, col = "black",
     xlab = "", ylab = "Mean FP", main = "Normalized Mean FP Regression Change Points")
colors <- rainbow(length(segments))[-1]
for (i in 1:length(colors)) {
  idx <- (segments[i] + 1):segments[i + 1]
  intercept <- params$beta[i, 1]
  slope <- params$beta[i, 2]
  fitted <- intercept + slope * cor_norm$WY[idx]
  lines(cor_norm$WY[idx], fitted, col = colors[i], lwd = 2)
}
abline(h = 1, lwd = 2, col = "red")