library(changepoint)
library(ggplot2)
library(dplyr)

monsoon <- read.csv("monsoon_fp.csv")[-c(4, 5, 6, 9)]

cor(monsoon[-c(1, 6)], use = "pairwise.complete.obs")

monsoon$Mean <- rowMeans(monsoon[-1], na.rm = TRUE)

cpt.mean(na.omit(monsoon$Mean), method = "PELT")

matrix <- cbind(as.numeric(monsoon$Mean), 1, as.numeric(monsoon$WY))

cp_reg <- cpt.reg(matrix, method = "PELT")
segments <- c(0, cpts(cp_reg), nrow(monsoon))
params <- param.est(cp_reg)

plot(monsoon$WY, monsoon$Mean,
     pch = 19, col = "black",
     xlab = "", ylab = "Mean FP", main = "Monsoon Season FP Regression Change Points")
colors <- rainbow(length(segments) - 1)
for (i in 1:length(colors)) {
  idx <- (segments[i] + 1):segments[i + 1]
  intercept <- params$beta[i, 1]
  slope <- params$beta[i, 2]
  fitted <- intercept + slope * monsoon$WY[idx]
  lines(monsoon$WY[idx], fitted, col = colors[i], lwd = 2)
}

cp_var <- cpt.var(na.omit(monsoon$C2), method = "PELT")

mon_norm <- monsoon
mon_norm$C1 <- mon_norm$C1 / median(mon_norm$C1, na.rm = TRUE)
mon_norm$C2 <- mon_norm$C2 / median(mon_norm$C2, na.rm = TRUE)
mon_norm$C6 <- mon_norm$C6 / median(mon_norm$C6, na.rm = TRUE)
mon_norm$C7 <- mon_norm$C7 / median(mon_norm$C7, na.rm = TRUE)
mon_norm$Mean <- mon_norm$Mean / median(mon_norm$Mean, na.rm = TRUE)

cpt.mean(na.omit(mon_norm$Mean), method = "PELT")

plot(mon_norm$WY, mon_norm$Mean,
     pch = 19, col = "black",
     xlab = "", ylab = "NMFP")
abline(h = 1, col = "red")

precip <- read.csv("precipitation_gao.csv")[c(1, 3, 4, 8, 9)]
precip$date <- as.Date(precip$date, format = "%Y_%m_%d")
precip$month <- as.numeric(format(precip$date, "%m"))

water_year <- function(date) {
  y <- as.numeric(format(date, "%Y"))
  m <- as.numeric(format(date, "%m"))
  ifelse(m >= 10, y + 1, y)
}

precip$wy <- water_year(precip$date)
precip <- precip[precip$month %in% c(7, 8, 9),]
precip <- precip %>%
  group_by(wy) %>%
  summarise(across(starts_with("point"), ~ mean(.x, na.rm = TRUE)))

precip$mean <- rowMeans(precip[-1])
cpt.mean(precip$mean, method = "PELT")

plot(precip$wy, precip$mean,
     pch = 19, col = "black",
     xlab = "", ylab = "Mean Precipitation")

daymet <- read.csv("daymet_precip.csv")[-1]

daymet <- daymet[daymet$camera %in% c(1, 2, 6, 7),]

names(daymet) <- c("wy", "precip", "camera")

yearly <- daymet %>%
  group_by(wy) %>%
  summarise(mean = mean(precip, na.rm = TRUE))

matrix <- cbind(yearly$mean, 1, as.numeric(yearly$wy))
cpt.reg(matrix, method = "PELT")

cpt.mean(daymet[daymet$camera == 1,]$precip, method = "PELT", minseglen = 7)

poly <- data.frame(wy = seq(min(daymet$wy), max(daymet$wy), length.out = 200))
poly$fit <- predict(lm(precip ~ poly(wy, 2), data = daymet), newdata = poly)

plot(yearly$wy, yearly$mean,
     pch = 19, col = "black",
     xlab = "", ylab = "Total Precipitation (mm/day)", main = "Total Yearly Precipitation")

lines(poly$wy, poly$fit,
      col = "red", lwd = 3)
